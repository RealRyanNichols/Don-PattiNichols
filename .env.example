# Environment variables for the Don & Patti Nichols site.
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables). NEXT_PUBLIC_* are exposed to
# the browser; everything else is server-only. None are required to build —
# missing keys degrade gracefully (forms/giving show "being set up").

# --- Supabase (public) -------------------------------------------------------
# Safe to expose; RLS limits the anon key to public reads + the open form
# INSERTs. Hardcoded fallbacks exist in lib/supabase.ts, but set these to be
# explicit / to point at a different project.
NEXT_PUBLIC_SUPABASE_URL=https://rxjsykcbedtyxfvyfyhl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Supabase (server-only, SECRET) ------------------------------------------
# Service role key — bypasses RLS. Used ONLY by the Stripe webhook to record
# donations and credit trips. Never expose to the browser. Supabase dashboard →
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-only, SECRET) --------------------------------------------
# Start in TEST mode (sk_test_..., whsec_...). Create a webhook endpoint in the
# Stripe dashboard pointing at https://<your-domain>/api/stripe/webhook and
# subscribe to checkout.session.completed; paste its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics (public, optional) --------------------------------------------
# Empty = the GA4 / Meta Pixel scripts are not loaded at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Notifications (server-only, optional) -----------------------------------
# Emails the mission inbox when a contact/prayer message or newsletter signup
# comes in. Empty RESEND_API_KEY = no email is sent (the row is still saved).
# MISSION_NOTIFY_FROM must be a Resend-verified sender once the domain is set up;
# until then Resend's onboarding@resend.dev test sender is used.
RESEND_API_KEY=
MISSION_NOTIFY_EMAIL=missions@donandpattinichols.org
MISSION_NOTIFY_FROM=Mission Website <onboarding@resend.dev>
